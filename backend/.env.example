# Copiar a .env y completar con los valores reales.
# En Render estas variables se cargan en el servicio -> Environment.

# Puerto (Render lo asigna automáticamente; en local podés usar 3000)
PORT=3000

# Conexión al proyecto Supabase (service role — SOLO en el backend, nunca en el frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Origen permitido para CORS (la URL del frontend en Vercel)
FRONTEND_ORIGIN=
