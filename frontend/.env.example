# Copiar a .env y completar con los valores reales.
# En Vercel estas variables se cargan en Project Settings -> Environment Variables.

# URL y clave pública (anon) del proyecto Supabase "app-facturacion"
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL pública del backend en Render (ej: https://app-facturacion-backend.onrender.com)
VITE_BACKEND_URL=
